# ==============================================================================
# Fake News Detector - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials:
#   cp .env.example .env
# ==============================================================================

# ── Primary LLM Provider: Groq Cloud ──
# Groq provides ultra-fast inference and a generous free tier.
# Sign up and obtain an API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Secondary / Fallback LLM Provider: Google Gemini ──
# Used as an alternative backend or fallback if Groq encounters rate limits.
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── Default LLM Backend ──
# Specifies which backend to use: "groq" (default) or "gemini"
DEFAULT_LLM_BACKEND=groq

# ── Python & Path Configuration ──
# Ensures python modules 'rag' and 'web' are discoverable.
PYTHONPATH=.

# ── Optional RAG Directory Overrides ──
# Uncomment only if your databases reside outside the default rag/data directory.
# RAG_GENERAL__DATA_DIR=./rag/data
# RAG_VECTOR_STORE__PERSIST_DIR=./rag/data/indexes/chroma
# RAG_BM25__INDEX_PATH=./rag/data/indexes/bm25.pkl
